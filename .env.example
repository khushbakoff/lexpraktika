# AI kaliti (faqat serverda)
AI_API_KEY=

# MongoDB (faqat serverda). Baza nomi alohida bo'lsin, boshqa loyihalar bazalariga tegmang.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=lexsim

# Sessiya imzosi: kamida 32 belgi, tasodifiy. Yaratish: openssl rand -base64 48
SESSION_SECRET=

# Faqat HTTPS orqali ishlaganda true qiling (aks holda kirish ishlamaydi)
COOKIE_SECURE=false

# AI mijoz modeli (ixtiyoriy, standart claude-opus-5-5)
AI_MODEL=

# Tarif: hisobda plan bo'lmasa shu qo'llanadi. Demo uchun pro, ishga tushirishda free (yoki bo'sh)
DEFAULT_PLAN=

# Ilovaning tashqi manzili (OAuth qaytish manzili uchun). Mahalliy: http://localhost:3000
APP_URL=


# Telegram orqali kirish: @BotFather da bot yarating va /setdomain bilan domen kiriting (domen kerak, IP emas).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

AI_BASE_URL=
